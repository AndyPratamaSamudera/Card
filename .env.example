# ── OVERLOAD 21 — environment ─────────────────────────────────────────
# Copy to .env and adjust. Read by both the server and the Vite client.
#
# *_HOST = the network address the process listens on:
#   0.0.0.0        → reachable via localhost AND your LAN IP (recommended)
#   127.0.0.1      → this computer only
#   192.168.x.x    → only via that IP (localhost will NOT work)

# Backend (Fastify + Socket.IO). In production it also serves the client.
SERVER_PORT=4000
SERVER_HOST=0.0.0.0

# Frontend dev server (npm run dev). Proxies /socket.io to the backend.
CLIENT_PORT=3000
CLIENT_HOST=0.0.0.0
